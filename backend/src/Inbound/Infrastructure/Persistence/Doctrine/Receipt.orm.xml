<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Inbound\Domain\Receipt" table="receipts">
        <indexes>
            <index name="idx_receipts_asn" columns="asn_id"/>
        </indexes>

        <id name="id" type="receipt_id"/>
        <field name="tenantId" column="tenant_id" type="tenant_id"/>
        <!-- INB-05: one ASN per receipt. No foreign key, like every reference between aggregates. -->
        <field name="asnId" column="asn_id" type="asn_id"/>
        <field name="dockLocationId" column="dock_location_id" type="inbound_location_id"/>
        <field name="status" enum-type="App\Inbound\Domain\ReceiptStatus" length="20"/>
        <field name="overReceiptApproved" column="over_receipt_approved" type="boolean"/>
        <field name="expected" type="inbound_expected_items"/>
        <field name="lines" type="inbound_received_lines"/>
        <field name="openedAt" column="opened_at" type="datetime_immutable"/>
        <field name="closedAt" column="closed_at" type="datetime_immutable" nullable="true"/>
        <field name="closedBy" column="closed_by" type="operator_id" nullable="true"/>
        <field name="stockBookedAt" column="stock_booked_at" type="datetime_immutable" nullable="true"/>
    </entity>
</doctrine-mapping>
