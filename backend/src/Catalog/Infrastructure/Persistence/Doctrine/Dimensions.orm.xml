<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <embeddable name="App\Catalog\Domain\Dimensions">
        <field name="lengthMm" column="length_mm" type="integer"/>
        <field name="widthMm" column="width_mm" type="integer"/>
        <field name="heightMm" column="height_mm" type="integer"/>
        <field name="weightGrams" column="weight_grams" type="integer"/>
    </embeddable>
</doctrine-mapping>
