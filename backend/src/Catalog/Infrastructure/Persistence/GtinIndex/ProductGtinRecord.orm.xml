<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Catalog\Infrastructure\Persistence\GtinIndex\ProductGtinRecord" table="product_gtins">
        <indexes>
            <index name="idx_product_gtins_product" columns="product_id"/>
        </indexes>

        <!-- CAT-02: one row per tenant and GTIN (padded to 14 digits) makes a GTIN belong to one product. -->
        <id name="tenantId" column="tenant_id" type="guid"/>
        <id name="gtin" type="string" length="14"/>
        <field name="productId" column="product_id" type="guid"/>
    </entity>
</doctrine-mapping>
