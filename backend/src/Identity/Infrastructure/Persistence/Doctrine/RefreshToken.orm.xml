<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Identity\Domain\RefreshToken" table="refresh_tokens">
        <unique-constraints>
            <!-- A secret belongs to one token. Only its hash is kept. -->
            <unique-constraint name="uniq_refresh_tokens_secret_hash" columns="secret_hash"/>
        </unique-constraints>
        <indexes>
            <index name="idx_refresh_tokens_family" columns="family_id"/>
        </indexes>

        <id name="id" type="string" length="36"/>
        <field name="familyId" column="family_id" type="string" length="36"/>
        <field name="userId" column="user_id" type="user_id"/>
        <field name="secretHash" column="secret_hash" type="string" length="64"/>
        <field name="issuedAt" column="issued_at" type="datetime_immutable"/>
        <field name="expiresAt" column="expires_at" type="datetime_immutable"/>
        <field name="sessionEndsAt" column="session_ends_at" type="datetime_immutable"/>
        <field name="rotatedAt" column="rotated_at" type="datetime_immutable" nullable="true"/>
        <field name="revokedAt" column="revoked_at" type="datetime_immutable" nullable="true"/>
    </entity>
</doctrine-mapping>
