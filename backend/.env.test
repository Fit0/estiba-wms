# Variables for the test env. APP_SECRET and JWT_PASSPHRASE come from .env (see .env.example).
KERNEL_CLASS='App\Kernel'

# The tests have no Mercure hub (config/services_test.yaml); the keys sign the tokens they check.
MERCURE_URL=http://localhost/.well-known/mercure
MERCURE_PUBLISHER_JWT_KEY=test-publisher-key-that-is-long-enough-for-hs256
MERCURE_SUBSCRIBER_JWT_KEY=test-subscriber-key-that-is-long-enough-for-hs256
