# The web server of the production image (ADR 0052). It serves the built app and sends what is not the
# app to the API, so the browser talks to one address only, as it does with the development server
# (ADR 0021).
#
# API_UPSTREAM is where the API is, as an address with its scheme: http://php:80 or https://api.example.com.
# PORT is where this server listens. TLS is ended in front of the container, by the platform or a proxy.
{
	admin off
	auto_https off
}

:{$PORT:80} {
	encode zstd gzip

	@api path /api/* /health
	handle @api {
		reverse_proxy {$API_UPSTREAM:http://php:80} {
			header_up Host {upstream_hostport}
		}
	}

	# The notifications are a stream that stays open (ADR 0045): nothing may hold the answer back.
	handle /.well-known/mercure {
		reverse_proxy {$API_UPSTREAM:http://php:80} {
			header_up Host {upstream_hostport}
			flush_interval -1
		}
	}

	# The files of a build carry a hash in their name, so they never change under the same name.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is looked at again each time: index.html and the service worker are what tell the
	# browser which version to use. A route of the app, such as /orders, is index.html.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
